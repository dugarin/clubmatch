# Скопировать в .env и заполнить. .env НЕ коммитится (.gitignore); на сервере chmod 600 .env
#
# Локальная разработка: docker-compose.yml (make dev), go-тесты.
# Stage: docker-compose.stage.yml берёт значения из этого же файла на сервере
# (docs/ops/stage.md). Пометка (секрет) — не попадать в логи/коммиты.

# ── Backend (dev + stage) ─────────────────────────────────────────────
# На stage это значение ПЕРЕКРЫВАЕТСЯ compose: БД = соседний контейнер db.
DATABASE_URL=postgres://clubmatch:clubmatch@localhost:5432/clubmatch?sslmode=disable
HTTP_ADDR=:8080
APP_ENV=dev                     # на stage compose ставит stage автоматически
TELEGRAM_BOT_TOKEN=             # токен бота от @BotFather (секрет)
TELEGRAM_WEBHOOK_SECRET=        # секрет X-Telegram-Bot-Api-Secret-Token (секрет)
INITDATA_TTL_HOURS=24
WORKER_POLL_SECONDS=30
TELEGRAM_BOT_USERNAME=          # username бота без @ — для ссылок-приглашений (ADR-002 п.2a)
TELEGRAM_MINIAPP_NAME=          # короткое имя Mini App из @BotFather — для ссылок-приглашений

# ── Stage-окружение (docker-compose.stage.yml) ────────────────────────
POSTGRES_USER=clubmatch
POSTGRES_PASSWORD=              # ОБЯЗАТЕЛЬНО на stage (секрет): без него compose не поднимется
POSTGRES_DB=clubmatch
STAGE_DOMAIN=                   # домен stage: A-запись → IP сервера; Caddy получит TLS автоматически

# ── Бэкапы (ops/backup.sh) ────────────────────────────────────────────
BACKUP_DIR=./backups            # каталог дампов (создаётся автоматически)
RETENTION_DAYS=14               # хранение дампов, дней
MODERATOR_TG_IDS=             # telegram id модераторов через запятую (D-3.8, FR-15)
